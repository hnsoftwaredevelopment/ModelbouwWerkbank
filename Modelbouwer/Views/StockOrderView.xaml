<UserControl x:Class="Modelbouwer.Views.StockOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
             xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
             xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
             xmlns:controls="clr-namespace:Modelbouwer.Controls"
             xmlns:converters="clr-namespace:Modelbouwer.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:StockOrderViewModel}">
    <UserControl.Resources>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- KAN-103: order selection on top, order header, then product list (left) and order lines (right). -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: order selection and toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource ActionBarButtonStyle}"
                        Command="{Binding NewOrderCommand}"
                        ToolTip="{x:Static language:Language.toolbarButtonActionNew}">
                    <Image Style="{DynamicResource ToolBarAddIcon}" />
                </Button>
                <Button Style="{StaticResource ActionBarButtonStyle}"
                        Command="{Binding SaveOrderCommand}"
                        ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                    <Image Style="{DynamicResource ToolBarSaveIcon}" />
                </Button>
                <Button Style="{StaticResource ActionBarButtonStyle}"
                        Command="{Binding DeleteOrderCommand}"
                        ToolTip="{x:Static language:Language.toolbarButtonActionDelete}">
                    <Image Style="{DynamicResource ToolBarDeleteIcon}" />
                </Button>
                <controls:OrderSelector Margin="16,0,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Foreground="DarkOrange"
                       Text="{x:Static language:Language.StockOrderUnsavedChanges}"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <!-- Row 1: order header -->
        <TabControl Grid.Row="1" Margin="0,0,0,10">
            <TabItem Header="{x:Static language:Language.OrderOrderGroupOrderinformation}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderOrderSelectionSupplierLabel}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,6"
                              ItemsSource="{Binding Suppliers}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding EditableOrder.SupplierId, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeSupplier}"
                              ToolTip="{x:Static language:Language.StockOrderSupplierLockedTooltip}"
                              ToolTipService.ShowOnDisabled="True" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderOrderSelectionOrdernumberLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,12,6"
                             Text="{Binding EditableOrder.OrderNumber, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditOrder}" />

                    <TextBlock Grid.Row="0" Grid.Column="4" Margin="0,0,8,6" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderOrderSelectionOrderdateLabel}" />
                    <DatePicker Grid.Row="0" Grid.Column="5" Margin="0,0,0,6"
                                SelectedDate="{Binding EditableOrder.OrderDate, Mode=TwoWay}"
                                IsEnabled="{Binding CanEditOrder}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderOrderSelectionCurrencyLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,6"
                              ItemsSource="{Binding Currencies}"
                              DisplayMemberPath="CurrencyName"
                              SelectedValuePath="CurrencyId"
                              SelectedValue="{Binding EditableOrder.CurrencyId, Mode=TwoWay}"
                              IsEnabled="{Binding CanEditOrder}" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,8,6" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderOrderSelectionDeliverycostsLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,12,6"
                             Text="{Binding EditableOrder.ShippingCosts, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}"
                             IsEnabled="{Binding CanEditOrder}" />

                    <TextBlock Grid.Row="1" Grid.Column="4" Margin="0,0,8,6" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderOrderSelectionOrdercostsLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="5" Margin="0,0,0,6"
                             Text="{Binding EditableOrder.OrderCosts, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}"
                             IsEnabled="{Binding CanEditOrder}" />

                    <TextBlock Grid.Row="2" Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderTotalLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="5" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"
                               Text="{Binding EditableOrder.GrandTotal, StringFormat={}{0:N2}}" />
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static language:Language.OrderTabItemHeaderMemo}">
                <controls:RtfEditor Height="110"
                                    Margin="5"
                                    IsEnabled="{Binding CanEditOrder}"
                                    RtfText="{Binding EditableOrder.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </TabItem>
        </TabControl>

        <!-- Row 2: product list (left) and order lines (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{x:Static language:Language.StockOrderProductsGroupTitle}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Style="{StaticResource ActionBarButtonStyle}"
                                    Command="{Binding AddProductToOrderCommand}"
                                    ToolTip="{x:Static language:Language.StockOrderMenuAddToOrder}">
                                <Image Style="{DynamicResource ToolBarAddProductToOrderIcon}" />
                            </Button>
                            <TextBlock Margin="12,0,8,0" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderOnlyShortages}" />
                            <ToggleButton VerticalAlignment="Center"
                                          IsChecked="{Binding ShowOnlyShortages, Mode=TwoWay}"
                                          Style="{StaticResource ToggleSwitchStyle}" />
                            <Button Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center"
                                    Command="{Binding AddShortagesCommand}"
                                    Content="{x:Static language:Language.StockOrderAddShortages}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Width="200"
                                     VerticalAlignment="Center"
                                     Style="{DynamicResource DefaultTextBox}"
                                     Tag="{x:Static language:Language.SearchGridTag}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{x:Static language:Language.SearchGridTooltip}" />
                            <Button Width="24" Height="24" Margin="5,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding ClearSearchCommand}"
                                    Style="{DynamicResource ClearButtonStyle}" />
                        </StackPanel>
                    </DockPanel>

                    <syncfusion:SfDataGrid x:Name="ProductsGrid"
                                           Grid.Row="1"
                                           ItemsSource="{Binding ProductRows}"
                                           SelectedItem="{Binding SelectedProductRow, Mode=TwoWay}"
                                           AutoGenerateColumns="False"
                                           AllowEditing="False"
                                           AllowResizingColumns="True"
                                           AllowSorting="True"
                                           AllowTriStateSorting="True"
                                           AutoExpandGroups="True"
                                           ColumnSizer="Star"
                                           SelectionMode="Single"
                                           NavigationMode="Row"
                                           GridContextMenuOpening="ProductsGrid_GridContextMenuOpening">
                        <syncfusion:SfDataGrid.GroupColumnDescriptions>
                            <syncfusion:GroupColumnDescription ColumnName="GroupName" />
                        </syncfusion:SfDataGrid.GroupColumnDescriptions>
                        <syncfusion:SfDataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding AddProductToOrderCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding AddProductToOrderCommand}" />
                        </syncfusion:SfDataGrid.InputBindings>
                        <syncfusion:SfDataGrid.RecordContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static language:Language.StockOrderMenuAddToOrder}"
                                          FontWeight="SemiBold"
                                          Command="{Binding DataGrid.DataContext.AddProductToOrderCommand}" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.RecordContextMenu>
                        <syncfusion:SfDataGrid.Columns>
                            <!-- Shortage icons, same rules and icons as the stock overview -->
                            <syncfusion:GridTemplateColumn MappingName="ShortInventory" HeaderText="" Width="26" AllowSorting="False">
                                <syncfusion:GridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Margin="3">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{x:Null}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TempShortInventory, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                            <Setter Property="Source" Value="{DynamicResource tempshort}" />
                                                            <Setter Property="ToolTip" Value="{x:Static language:Language.StockManagementDataGridValueTempShortWarning}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShortInventory, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                            <Setter Property="Source" Value="{DynamicResource short}" />
                                                            <Setter Property="ToolTip" Value="{x:Static language:Language.StockManagementDataGridValueShortWarning}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </DataTemplate>
                                </syncfusion:GridTemplateColumn.CellTemplate>
                            </syncfusion:GridTemplateColumn>
                            <syncfusion:GridTextColumn MappingName="ProductCode" HeaderText="{x:Static language:Language.StockOrderProductGridHeaderProductCode}" Width="110" />
                            <syncfusion:GridTextColumn MappingName="SupplierProductNumber" HeaderText="{x:Static language:Language.StockOrderProductDialogSupplierProductNumber}" Width="120" />
                            <syncfusion:GridTextColumn MappingName="ProductName" HeaderText="{x:Static language:Language.StockOrderProductGridHeaderProductName}" />
                            <syncfusion:GridNumericColumn MappingName="MinimalStock" HeaderText="{x:Static language:Language.StockManagementDataGridHeaderMinimalStock}" NumberDecimalDigits="0" Width="80" />
                            <syncfusion:GridNumericColumn MappingName="Inventory" HeaderText="{x:Static language:Language.StockOrderProductGridHeaderCurrentInventory}" NumberDecimalDigits="0" Width="80" />
                            <syncfusion:GridNumericColumn MappingName="TotalInOrder" HeaderText="{x:Static language:Language.StockManagementDataGridHeaderOrdered}" NumberDecimalDigits="0" Width="80" />
                            <syncfusion:GridNumericColumn MappingName="StandardOrderQuantity" HeaderText="{x:Static language:Language.StockOrderProductGridHeaderOrderQuantity}" NumberDecimalDigits="0" Width="80" />
                            <syncfusion:GridNumericColumn MappingName="SuggestedAmount" HeaderText="{x:Static language:Language.StockOrderProductGridHeaderSuggested}" NumberDecimalDigits="0" Width="80" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="{x:Static language:Language.StockOrderLinesGroupTitle}">
                <syncfusion:SfDataGrid x:Name="OrderLinesGrid"
                                       Margin="8"
                                       ItemsSource="{Binding OrderLines}"
                                       SelectedItem="{Binding SelectedOrderLine, Mode=TwoWay}"
                                       AutoGenerateColumns="False"
                                       AllowEditing="{Binding CanEditOrder}"
                                       EditTrigger="OnTap"
                                       AllowResizingColumns="True"
                                       AllowSorting="True"
                                       ColumnSizer="Star"
                                       SelectionMode="Single"
                                       NavigationMode="Cell"
                                       CurrentCellBeginEdit="OrderLinesGrid_CurrentCellBeginEdit"
                                       GridContextMenuOpening="OrderLinesGrid_GridContextMenuOpening">
                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Closed}" Value="True">
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>
                    <syncfusion:SfDataGrid.RecordContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static language:Language.StockReceiptMenuEditSupplierData}"
                                      Command="{Binding DataGrid.DataContext.EditLineSupplierDataCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static language:Language.StockOrderMenuDeleteLine}"
                                      Command="{Binding DataGrid.DataContext.DeleteOrderLineCommand}" />
                        </ContextMenu>
                    </syncfusion:SfDataGrid.RecordContextMenu>
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="DisplayProductNumber" HeaderText="{x:Static language:Language.StockOrderProductDialogSupplierProductNumber}" AllowEditing="False" Width="110" />
                        <syncfusion:GridTextColumn MappingName="DisplayProductDescription" HeaderText="{x:Static language:Language.StockOrderProductDialogSupplierProductName}" AllowEditing="False" />
                        <syncfusion:GridNumericColumn MappingName="Amount" HeaderText="{x:Static language:Language.StockOrderLineGridHeaderOrderedAmount}" AllowEditing="True" NumberDecimalDigits="2" Width="80" />
                        <syncfusion:GridNumericColumn MappingName="Price" HeaderText="{x:Static language:Language.StockOrderLineGridHeaderProductPrice}" AllowEditing="True" NumberDecimalDigits="2" Width="85" />
                        <syncfusion:GridNumericColumn MappingName="RealRowTotal" HeaderText="{x:Static language:Language.StockOrderLineGridHeaderRowTotal}" AllowEditing="False" NumberDecimalDigits="2" Width="90" />
                        <syncfusion:GridNumericColumn MappingName="Received" HeaderText="{x:Static language:Language.StockReceiptAlreadyReceivedLabel}" AllowEditing="False" NumberDecimalDigits="0" Width="80" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
