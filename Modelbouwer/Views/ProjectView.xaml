<UserControl
    x:Class="Modelbouwer.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hlp="clr-namespace:Modelbouwer.Helpers"
    xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
    xmlns:local="clr-namespace:Modelbouwer.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewmodels="clr-namespace:Modelbouwer.ViewModels"
    xmlns:helpers="clr-namespace:Modelbouwer.Helpers"
    xmlns:converters="clr-namespace:Modelbouwer.Converters"
    xmlns:controls="clr-namespace:Modelbouwer.Controls"
    d:DataContext="{d:DesignInstance Type=viewmodels:ProjectPageViewModel}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ByteToImageConverter x:Key="ByteToImageConverter" DefaultImage="{StaticResource noimage}" />
        <converters:ByteToImageConverter x:Key="NullOrEmptyImageConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:WorkTimeAggregate x:Key="WorkTimeAggregate" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="85" />
            <!-- 1. Detail tabs (KAN-147) -->
            <RowDefinition Height="300" MinHeight="150" />
            <!-- 2. Splitter: makes the detail tabs taller or shorter -->
            <RowDefinition Height="Auto" />
            <!-- 3. Toolbar and project list -->
            <RowDefinition Height="*" MinHeight="150" />
            <!-- 4. Footer -->
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!--#region Page header-->
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackground}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Image
                    Style="{DynamicResource HeaderIconStyle}"
                    Source="{StaticResource Projects}" />
                <TextBlock Style="{DynamicResource HeaderTitle}" Text="{x:Static language:Language.metadataProjectHeaderTitel}" />
            </StackPanel>
            <Canvas>
                <Path Style="{DynamicResource HeadertTitleLine}" />
            </Canvas>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource HeaderSubTitle}" Text="{x:Static language:Language.metadataProjectHeaderSubtitle}" />

                <TextBlock Text="{x:Static language:Language.generalUnsavedChanges}"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Style="{DynamicResource TextBlockUnsavedChangesWarning}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->

        <!--#region Details (KAN-147: tabs at the bottom, as on the supplier and product screens)-->
        <syncfusion:TabControlExt
            Name="tabControl"
            Grid.Row="1"
            TabStripPlacement="Bottom" CloseButtonType="Hide"
            TabItemHeaderStyle="Curve"
            Height="Auto"
            Width="Auto">

            <!--#region General-->
            <syncfusion:TabItemExt
                Header="{x:Static language:Language.metadataProjectDetailTabGeneralTitle}"
                Image="{StaticResource project}"
                ImageWidth="17"
                ImageHeight="17">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
            Margin="5,8,5,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="32" />
                <RowDefinition Height="20" />
                <RowDefinition Height="32" />
                <RowDefinition Height="81" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <!--#region  Project code  -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                <Label Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldCode}"
                       Style="{DynamicResource EntryLabel}" />

                <Label Style="{DynamicResource EntrySemicolon}" />
            </StackPanel>

            <TextBox
                Grid.Row="1"
                Grid.Column="0"
                Margin="5 0 0 0"
                Width="150"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldCodeTag}"
                Text="{Binding SelectedItem.ProjectCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldCodeTooltip}" />
            <!--#endregion-->

            <!--#region  Project name  -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                <Label
                    Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldName}"
                    Style="{DynamicResource EntryLabel}" />

                <Label
                    Style="{DynamicResource EntrySemicolon}" />
            </StackPanel>

            <TextBox
                Grid.Row="1"
                Margin="5 0 0 0"
                Grid.Column="1"
                Width="500"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldNameTag}"
                Text="{Binding SelectedItem.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldNameTooltip}" />
            <!--#endregion-->

            <!--#region Start date  -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0">
                <Label
                    Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldStartDate}"
                    Style="{DynamicResource EntryLabel}" />

                <Label
                    Style="{DynamicResource EntrySemicolon}" />
            </StackPanel>

            <DatePicker
                x:Name="ProjectStartDate"
                Grid.Row="3"
                Grid.Column="0"
                Margin="5 0 0 0"
                Width="150"
                HorizontalAlignment="Left"
                Style="{DynamicResource DefaultDatePicker}"
                Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldStartDateTag}"
                SelectedDate="{Binding SelectedItem.ProjectStartDate,Mode=TwoWay, Converter={StaticResource DateOnlyConverter}}"
                ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldStartDateTooltip}"
                />
            <!--#endregion-->

            <!--#region End date, Close toggle and Expected Build Time-->
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- End date -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                    <Label
                        Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldEndDate}"
                        Style="{DynamicResource EntryLabel}"
                        Visibility="{Binding EndDatePickerVisibility}"/>

                    <Label
                        Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedEndDate}"
                        Style="{DynamicResource EntryLabel}"
                        Visibility="{Binding ExpectedEndDateVisibility}"/>

                    <Label
                        Style="{DynamicResource EntrySemicolon}" />
                </StackPanel>

                <!-- Close toggle -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                    <Label
                        Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldStatus}"
                        Style="{DynamicResource EntryLabel}" />

                    <Label
                        Style="{DynamicResource EntrySemicolon}" />
                </StackPanel>

                <!-- Expected Build hours -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2">
                    <Label
                        Content="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedWorkTime}"
                        Style="{DynamicResource EntryLabel}" />

                    <Label
                        Style="{DynamicResource EntrySemicolon}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- End date -->
                <DatePicker
                    x:Name="ProjectEndDate"
                    Grid.Column="0"
                    Width="150" Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Style="{DynamicResource DefaultDatePicker}"
                    Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldEndDateTag}"
                    SelectedDate="{Binding SelectedItem.ProjectEndDate,Mode=TwoWay, Converter={StaticResource DateOnlyConverter}}"
                    ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldEndDateTooltip}" Grid.ColumnSpan="2"
                    Visibility="{Binding EndDatePickerVisibility}" />

                <TextBox
                    Visibility="{Binding ExpectedEndDateVisibility}"
                    Style="{DynamicResource DefaultTextBox}"
                    ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedEndDateTooltip}"
                    Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedEndDateTag}"
                    Grid.Column="0" Width="150"
                    Margin="5,0,0,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding ProjectExpectedEndDate, Mode=OneWay, StringFormat={}{0:dd-MM-yyyy}}" Padding="2,0,2,0" />

                <!-- Status toggle -->
                <ToggleButton
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderBrush="White"
                    IsChecked="{Binding SelectedItem.ProjectClosed, Mode=TwoWay}"
                    Style="{StaticResource SwitchButton}"/>

                <TextBox
                    Margin="5,4,0,4"
                    Grid.Column="2"
                    Width="120"
                    Style="{DynamicResource DefaultTextBox}"
                    Tag="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedWorkTimeTag}"
                    Text="{Binding SelectedItem.ProjectExpectedTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{x:Static language:Language.metadataProjectTabGeneralTabItemGeneralFieldExpectedWorkTimeTooltip}" />
            </Grid>
            <!--#endregion-->

            <!--#region Image and Image toolbar -->
            <Grid Grid.Row="0" Grid.Column="3" Grid.RowSpan="5" Height="183" VerticalAlignment="Top">
                <controls:ImageEditor
                    ImageSource="{Binding SelectedItem.ProjectImage, Mode=TwoWay}"
                    RotationAngle="{Binding SelectedItem.ProjectImageRotationAngle, Mode=TwoWay}"
                    AddImageCommand="{Binding AddImageCommand}"
                    DeleteImageCommand="{Binding DeleteImageCommand}"
                    RotateCommand="{Binding RotateCommand}" />
            </Grid>
            <!--#endregion-->
        </Grid>

        <!--#region Cost overview: material, hours at the hour rate, total (KAN-147)-->
        <Grid Grid.Column="1" Margin="25,8,15,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200" />
                <ColumnDefinition Width="Auto" MinWidth="80" />
                <ColumnDefinition Width="Auto" MinWidth="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6" FontSize="14" FontWeight="Bold" Text="{x:Static language:Language.ProjectCostsTitle}" />

            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="0,0,0,1" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,3" FontWeight="Bold" Text="{x:Static language:Language.ProjectCostsHeaderType}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,0,0,3" FontWeight="Bold" TextAlignment="Right" Text="{x:Static language:Language.ProjectCostsHeaderAmount}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,0,0,3" FontWeight="Bold" TextAlignment="Right" Text="{x:Static language:Language.ProjectCostsHeaderTotal}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,10,0" Text="{x:Static language:Language.ProjectCostsMaterial}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="10,4,0,0" TextAlignment="Right" Text="{Binding ProjectMaterialUsageCount, Mode=OneWay}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,4,0,0" TextAlignment="Right" Text="{Binding ProjectMaterialCostsText, Mode=OneWay}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,10,4" Text="{Binding ProjectHoursCostsLabel, Mode=OneWay}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="10,4,0,4" TextAlignment="Right" Text="{Binding ProjectTotalTime, Mode=OneWay}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,4,0,4" TextAlignment="Right" Text="{Binding ProjectHoursCostsText, Mode=OneWay}" />

            <!-- A single (sum) line above the grand total, a double line below it -->
            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,3,10,0" FontWeight="Bold" Text="{x:Static language:Language.ProjectCostsGrandTotal}" />
            <Border Grid.Row="4" Grid.Column="2" Margin="10,0,0,0" BorderBrush="Black" BorderThickness="0,1,0,0">
                <TextBlock Margin="0,3,0,2" FontWeight="Bold" TextAlignment="Right" Text="{Binding ProjectGrandTotalText, Mode=OneWay}" />
            </Border>
            <StackPanel Grid.Row="5" Grid.Column="2" Margin="10,0,0,0">
                <Rectangle Height="1" Fill="Black" />
                <Rectangle Height="1" Margin="0,2,0,0" Fill="Black" />
            </StackPanel>
        </Grid>
        <!--#endregion-->
        </Grid>

            </syncfusion:TabItemExt>
            <!--#endregion-->

            <!--#region Memo -->
            <syncfusion:TabItemExt
                Header="{x:Static language:Language.metadataProjectDetailTabMemoTitle}"
                Image="{StaticResource memo}"
                ImageWidth="17"
                ImageHeight="17">
                <controls:RtfEditor
                    x:Name="ProjectMemoEditor"
                    Margin="5"
                    RtfText="{Binding SelectedItem.ProjectMemo, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
            </syncfusion:TabItemExt>
            <!--#endregion-->

            <!--#region Hours worked (read only: hours are booked in time registration)-->
            <syncfusion:TabItemExt
                Header="{x:Static language:Language.metadataProjectDetailTabHoursTitle}"
                Image="{StaticResource Time}"
                ImageWidth="17"
                ImageHeight="17">
                <Grid Margin="15,8,15,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,6" FontSize="14" FontWeight="Bold">
                        <Run Text="{x:Static language:Language.ProjectHoursEntryCount}" />
                        <Run Text=": " />
                        <Run Text="{Binding ProjectTimeEntryCount, Mode=OneWay}" />
                        <Run Text="   " />
                        <Run Text="{x:Static language:Language.ProjectHoursTotal}" />
                        <Run Text=": " />
                        <Run Text="{Binding ProjectTotalTime, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Row="1"
                               Margin="5"
                               Foreground="Gray"
                               FontStyle="Italic"
                               Text="{x:Static language:Language.ProjectHoursEmpty}"
                               Visibility="{Binding HasProjectTimeEntries, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />

                    <!-- Grouped per work type, collapsed: each group header shows the work type, its worked time and its number of entries -->
                    <syncfusion:SfDataGrid
                        x:Name="ProjectHoursGrid"
                        Grid.Row="1"
                        AllowEditing="False"
                        AllowSorting="True"
                        AllowGrouping="False"
                        AutoExpandGroups="False"
                        ShowColumnWhenGrouped="False"
                        AutoGenerateColumns="False"
                        ColumnSizer="Star"
                        ItemsSource="{Binding ProjectTimeEntries}"
                        Visibility="{Binding HasProjectTimeEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <syncfusion:SfDataGrid.GroupColumnDescriptions>
                            <syncfusion:GroupColumnDescription ColumnName="WorktypeName" />
                        </syncfusion:SfDataGrid.GroupColumnDescriptions>
                        <syncfusion:SfDataGrid.SortColumnDescriptions>
                            <syncfusion:SortColumnDescription ColumnName="WorkDate" SortDirection="Descending" />
                        </syncfusion:SfDataGrid.SortColumnDescriptions>
                        <syncfusion:SfDataGrid.CaptionSummaryRow>
                            <syncfusion:GridSummaryRow ShowSummaryInRow="True" Title="{x:Static language:Language.ProjectHoursGroupCaption}">
                                <syncfusion:GridSummaryRow.SummaryColumns>
                                    <syncfusion:GridSummaryColumn Name="Time" MappingName="WorkedMinutes" SummaryType="Custom" CustomAggregate="{StaticResource WorkTimeAggregate}" Format="'{Time}'" />
                                    <syncfusion:GridSummaryColumn Name="Count" MappingName="WorkedMinutes" SummaryType="CountAggregate" Format="'{Count}'" />
                                </syncfusion:GridSummaryRow.SummaryColumns>
                            </syncfusion:GridSummaryRow>
                        </syncfusion:SfDataGrid.CaptionSummaryRow>
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridDateTimeColumn MappingName="WorkDate" HeaderText="{x:Static language:Language.ProjectHoursHeaderDate}" Pattern="ShortDate" Width="100" ColumnSizer="Auto" />
                            <syncfusion:GridTextColumn MappingName="WorktypeName" HeaderText="{x:Static language:Language.ProjectHoursHeaderWorkType}" />
                            <syncfusion:GridTextColumn MappingName="StartTime" HeaderText="{x:Static language:Language.ProjectHoursHeaderStart}" Width="70" ColumnSizer="Auto" TextAlignment="Center" />
                            <syncfusion:GridTextColumn MappingName="EndTime" HeaderText="{x:Static language:Language.ProjectHoursHeaderEnd}" Width="70" ColumnSizer="Auto" TextAlignment="Center" />
                            <syncfusion:GridNumericColumn MappingName="WorkedHours" HeaderText="{x:Static language:Language.ProjectHoursHeaderDuration}" NumberDecimalDigits="2" Width="70" ColumnSizer="Auto" />
                            <syncfusion:GridTextColumn MappingName="Comment" HeaderText="{x:Static language:Language.ProjectHoursHeaderComment}" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>
            <!--#endregion-->

            <!--#region Materials used (read only: usage is booked in time registration)-->
            <syncfusion:TabItemExt
                Header="{x:Static language:Language.metadataProjectDetailTabMaterialsTitle}"
                Image="{StaticResource product}"
                ImageWidth="17"
                ImageHeight="17">
                <Grid Margin="15,8,15,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock FontSize="14" FontWeight="Bold">
                            <Run Text="{x:Static language:Language.ProjectMaterialsLineCount}" />
                            <Run Text=": " />
                            <Run Text="{Binding ProjectMaterialUsageCount, Mode=OneWay}" />
                            <Run Text="   " />
                            <Run Text="{x:Static language:Language.ProjectMaterialsTotal}" />
                            <Run Text=": " />
                            <Run Text="{Binding ProjectMaterialCosts, Mode=OneWay, StringFormat={}{0:N2}}" />
                        </TextBlock>
                        <TextBlock Margin="15,0,0,0" VerticalAlignment="Bottom" Foreground="Gray" FontStyle="Italic"
                                   Text="{x:Static language:Language.ProjectMaterialsPriceNote}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Margin="5"
                               Foreground="Gray"
                               FontStyle="Italic"
                               Text="{x:Static language:Language.ProjectMaterialsEmpty}"
                               Visibility="{Binding HasProjectMaterialUsages, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />

                    <syncfusion:SfDataGrid
                        x:Name="ProjectMaterialsGrid"
                        Grid.Row="1"
                        AllowEditing="False"
                        AllowSorting="True"
                        AutoGenerateColumns="False"
                        ColumnSizer="Star"
                        ItemsSource="{Binding ProjectMaterialUsages}"
                        Visibility="{Binding HasProjectMaterialUsages, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridDateTimeColumn MappingName="UsageDate" HeaderText="{x:Static language:Language.ProjectMaterialsHeaderDate}" Pattern="ShortDate" Width="100" ColumnSizer="Auto" />
                            <syncfusion:GridTextColumn MappingName="ProductCode" HeaderText="{x:Static language:Language.ProjectMaterialsHeaderArticle}" Width="120" ColumnSizer="Auto" />
                            <syncfusion:GridTextColumn MappingName="ProductName" HeaderText="{x:Static language:Language.ProjectMaterialsHeaderDescription}" />
                            <syncfusion:GridNumericColumn MappingName="Amount" HeaderText="{x:Static language:Language.ProjectMaterialsHeaderAmount}" NumberDecimalDigits="2" Width="80" ColumnSizer="Auto" />
                            <syncfusion:GridTextColumn MappingName="UnitName" HeaderText="{x:Static language:Language.ProjectMaterialsHeaderUnit}" Width="90" ColumnSizer="Auto" />
                            <syncfusion:GridNumericColumn MappingName="Price" HeaderText="{x:Static language:Language.ProjectMaterialsHeaderPrice}" NumberDecimalDigits="2" Width="90" ColumnSizer="Auto" />
                            <syncfusion:GridNumericColumn MappingName="Costs" HeaderText="{x:Static language:Language.ProjectMaterialsHeaderCosts}" NumberDecimalDigits="2" Width="90" ColumnSizer="Auto" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>
            <!--#endregion-->
        </syncfusion:TabControlExt>
        <!--#endregion-->

        <GridSplitter
            Grid.Row="2"
            Height="6"
            Margin="0,1"
            HorizontalAlignment="Stretch"
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext"
            Background="LightGray"
            ToolTip="{x:Static language:Language.ProjectDetailSplitterTooltip}" />

        <Grid Grid.Row="3">
        <Grid.RowDefinitions>
            <!-- 0. Toolbar -->
            <RowDefinition Height="40" />
            <!-- 1. Project list -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region Toolbar section-->
        <Grid Grid.Row="0"
              Margin="15,2,15,2"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{Binding ImportStatus}"
                Foreground="Gray"
                FontStyle="Italic"
                Margin="5"
                Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                TextWrapping="Wrap"/>

            <!--#region Toolbar-->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2,0,2">
                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding AddProjectCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionNew}">
                    <Image Style="{DynamicResource ToolBarAddIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding DeleteProjectCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionDelete}">
                    <Image Style="{DynamicResource ToolBarDeleteIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Command="{Binding SaveProjectCommand}"
                    ToolTip="{x:Static language:Language.toolbarButtonActionSave}">
                    <Image Style="{DynamicResource ToolBarSaveIcon}" />
                </Button>

                <Border Style="{StaticResource ActionBarSeparatorStyle}" />

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonImport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionImport}">
                    <Image Style="{DynamicResource ToolBarImportIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonCSVExport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExportCSV}">
                    <Image Style="{DynamicResource ToolBarCSVExportIcon}" />
                </Button>

                <Button
                    Style="{StaticResource ActionBarButtonStyle}"
                    Click="ButtonExcelExport"
                    ToolTip="{x:Static language:Language.toolbarButtonActionExportExcel}">
                    <Image Style="{DynamicResource ToolBarExcelExportIcon}" />
                </Button>
            </StackPanel>
            <!--#endregion-->

            <!--#region Record Count Section -->
            <TextBlock
                Grid.Column="1"
                Width="Auto"
                Height="23" FontSize="14" FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Run Text="{x:Static language:Language.toolbarVisibleRowLabelProject}" />
                <Run Text=": " />
                <Run
                    FontSize="16"
                    Text="{Binding VisibleItemCount, StringFormat={}{0:N0}}"
                    FontStyle="Italic" />
                <Run Text=" " />
                <Run Text="{x:Static language:Language.toolbarVisibleRowLabelNumberSeperator}" FontWeight="Normal"/>
                <Run Text=" " />
                <Run Text="{Binding TotalProjectCount, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="16" FontWeight="Bold" FontStyle="Italic"/>
            </TextBlock>
            <!--#endregion-->

            <!--#region Search field-->
            <!--  Icon  -->
            <Image
                x:Name="FilterIcon"
                Grid.Column="2"
                Width="20"
                Height="20"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Source="{StaticResource search}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.3"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>

            <!--  Input field  -->
            <TextBox
                Grid.Column="3"
                Width="250"
                VerticalAlignment="Center"
                Style="{DynamicResource DefaultTextBox}"
                Tag="{x:Static language:Language.SearchGridTag}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static language:Language.SearchGridTooltip}" />

            <!--  Clear button  -->
            <Button
                Grid.Column="4"
                Width="24"
                Height="24"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding ClearSearchCommand}"
                Style="{DynamicResource ClearButtonStyle}" />
            <!--#endregion-->
        </Grid>
        <!--#endregion-->

        <!--#region Datagrid-->
        <syncfusion:SfDataGrid
            x:Name="SfDataGrid"
            Grid.Row="1"
            Margin="15,3,15,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AllowDraggingColumns="True"
            AllowGrouping="True"
            AllowSorting="True"
            AllowTriStateSorting="True"
            AutoGenerateColumns="False"
            ColumnSizer="Star"
            ItemsSource="{Binding Projects}"
            Loaded="ProjectDataGrid_Loaded"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

            <syncfusion:SfDataGrid.Columns>
                <!--#region hidden columns-->
                <syncfusion:GridTextColumn
                    Width="0"
                    IsHidden="True"
                    MappingName="ProjectId" />
                <!--#endregion-->

                <!--#region Project Code-->
                <syncfusion:GridTemplateColumn
                    Width="150"
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderCodeLabel}"
                    MappingName="ProjectCode">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5 0"
                                hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProjectCode}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region Project Name-->
                <syncfusion:GridTemplateColumn
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderNameLabel}"
                    MappingName="ProjectName">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5 0"
                                hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProjectName}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region StartDate -->
                <syncfusion:GridTemplateColumn
                    Width="100"
                    HorizontalAlignment="Center"
                    HorizontalHeaderContentAlignment="Center"
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderStartDateLabel}"
                    MappingName="ProjectStartDateDisplay">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProjectStartDateDisplay}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region EndDate -->
                <syncfusion:GridTemplateColumn
                    Width="100"
                    HorizontalAlignment="Center"
                    HorizontalHeaderContentAlignment="Center"
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderEndDateLabel}"
                    MappingName="ProjectEndDateDisplay">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                hlp:TextBlockHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Text="{Binding ProjectEndDateDisplay}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <!--#endregion-->

                <!--#region Project closed-->
                <syncfusion:GridCheckBoxColumn
                    Width="80"
                    MappingName="ProjectClosed"
                    HorizontalHeaderContentAlignment="Center"
                    HeaderText="{x:Static language:Language.metadataProjectDatagridHeaderClosedLabel}"
                    AllowEditing="False" HorizontalAlignment="Center"
                    IsThreeState="False" />
                <!--#endregion-->

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        <!--#endregion-->
        </Grid>

    </Grid>
</UserControl>
