<Window x:Class="Modelbouwer.Views.SupplierProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:Modelbouwer.Resources.Languages"
        Title="{x:Static language:Language.SupplierProductDialogTitle}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Foreground="Gray">
            <Run Text="{Binding Model.ProductCode, Mode=OneWay}" />
            <Run Text="  ·  " />
            <Run Text="{Binding Model.ProductName, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderProductDialogSupplierProductNumber}" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Model.SupplierProductNumber, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderProductDialogSupplierProductName}" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Model.SupplierProductName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="{x:Static language:Language.StockOrderProductDialogPrice}" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Model.UnitPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat={}{0:N4}}" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,12,8,0" Content="{x:Static language:Language.StockOrderProductDialogCancel}" IsCancel="True" />
            <Button Width="100" Margin="0,12,0,0" Content="{x:Static language:Language.StockOrderProductDialogConfirm}" IsDefault="True" Click="ConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
